        "contactEmail",
        "contactPhone",
        "residenceAddress",
        "fichaCode",
        "programName",
        "trainingLevel",
        "regionalCenter",
        "jornada",
        "lectivaStartDate",
        "lectivaEndDate",
        "productivaStartDate",
        "productivaEndDate",
        "selectedAlternative",
        "alternativeJustification",
        "companyName",
        "companyNit",
        "companyCity",
        "companyContactName",
        "companySector",
        "apprenticeSignatureAccepted",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "FichaSheetLink": {
      "title": "FichaSheetLink",
      "description": "Instructor-isolated Google Sheets and Google Drive synchronization metadata linked to a parent SENA Ficha.",
      "type": "object",
      "properties": {
        "fichaId": {
          "type": "string",
          "description": "Document ID of the linked parent Ficha.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fichaCode": {
          "type": "string",
          "description": "Official SENA ficha code.",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^[0-9A-Za-z\\-]+$"
        },
        "instructorId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning Ficha instructor.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "spreadsheetId": {
          "type": "string",
          "description": "Google Drive / Google Sheets file identifier.",
          "minLength": 10,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "spreadsheetUrl": {
          "type": "string",
          "description": "HTTPS URL to open the linked Google Sheets workbook.",
          "minLength": 20,
          "maxLength": 300
        },
        "spreadsheetTitle": {
          "type": "string",
          "description": "Display title of the Google Sheets workbook in Google Drive.",
          "minLength": 3,
          "maxLength": 160
        },
        "templateSourceName": {
          "type": "string",
          "description": "Reference template name used to structure the GFPI-F-165 workbook.",
          "minLength": 0,
          "maxLength": 140
        },
        "lastSyncedRows": {
          "type": "integer",
          "description": "Count of apprentice records synchronized during the latest run."
        },
        "lastDataSignature": {
          "type": "string",
          "description": "Deterministic hash of the last synchronized cohort snapshot.",
          "minLength": 0,
          "maxLength": 128,
