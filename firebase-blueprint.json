          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the GFPI-F-165 record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the GFPI-F-165 record was last updated."
        }
      },
      "required": [
        "userId",
